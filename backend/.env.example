# Copy this file to .env for local development and fill in real values.
# In production (Render), set these under your service's
# Environment -> Environment Variables instead of committing a .env file.

SECRET_KEY=
DEBUG=True

# Aiven MySQL
DB_NAME=defaultdb
DB_USER=avnadmin
DB_PASSWORD=
DB_HOST=
DB_PORT=21912

# Cloudinary (product/category/custom-jewelry image storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Brevo transactional REST API (OTP delivery)
#
# OTP emails are sent via POST https://api.brevo.com/v3/smtp/email, a
# direct HTTPS call from Django -- not SMTP. No SMTP host/port/login
# settings are needed.
#
# BREVO_SENDER_EMAIL - a sender address VERIFIED in your Brevo account.
# BREVO_SENDER_NAME  - display name for the From header (optional, defaults
#                       to "Jwelles").
# BREVO_API_KEY      - a REST API key from Brevo dashboard -> SMTP & API ->
#                       API Keys tab (format "xkeysib-..."). This is NOT
#                       the "SMTP key" from the SMTP tab (format
#                       "xsmtpsib-...") -- that one is for SMTP only and
#                       will be rejected by the REST API.
#
# Required in production (Render). If left blank there, OTP emails will
# fail to send and the app logs a CRITICAL error at startup -- see
# config/settings.py.
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Jwelles
BREVO_API_KEY=
